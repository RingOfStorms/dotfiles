{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": [
    "h001",
    "github-copilot"
  ],
  "model": "h001/air-gpt-5.6-luna",
  "default_agent": "build",
  "instructions": [
    "AGENTS.md",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "permission": {
    "edit": {
      "/nix/store/**": "deny"
    },
    "external_directory": {
      "$HOME/.cache": "allow",
      "/nix/store/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "agent": {
    "build": {
      "color": "#ff6f00",
      "model": "h001/air-gpt-5.6-luna"
    },
    "docs": {
      "disable": true
    },
    "explore": {
      "description": "Read-only repository exploration and web/documentation research. Specify quick, medium, or very thorough investigation.",
      "model": "h001/air-gemini-3.8-flash"
    },
    "general": {
      "description": "Implementation, debugging, testing, and multi-step execution. Use explore for read-only repository or documentation research.",
      "model": "h001/air-gpt-5.6-luna"
    },
    "plan": {
      "color": "#79bd04",
      "model": "h001/air-gpt-6-astra"
    },
    "summary": {
      "model": "h001/air-gpt-5.6-luna"
    },
    "title": {
      "model": "github-copilot/gpt-5.6-luna"
    }
  },
  "provider": {
    "h001": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "na",
        "baseURL": "http://h001.net.joshuabell.xyz:8094/v1"
      },
      "models": {
        "air-gemini-3.8-flash": {
          "name": "air-gemini-3.8-flash",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "air-gpt-5.6-luna": {
          "name": "air-gpt-5.6-luna",
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "max"
          }
        },
        "air-gpt-6-astra": {
          "name": "air-gpt-6-astra",
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  }
}
