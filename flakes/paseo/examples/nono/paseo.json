{
  "meta": {
    "description": "Paseo default provider boundary; cwd is granted per launch",
    "name": "paseo",
    "version": "1"
  },
  "extends": [
    "opencode"
  ],
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "$HOME/.omp"
    ],
    "read": [
      "$HOME/runtime/opencode"
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "USER",
      "LOGNAME",
      "TERM",
      "LANG",
      "LC_*",
      "XDG_*",
      "PASEO_AGENT_*",
      "OPENCODE_CONFIG_CONTENT",
      "NO_PROXY",
      "no_proxy",
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "http_proxy",
      "https_proxy"
    ]
  }
}
