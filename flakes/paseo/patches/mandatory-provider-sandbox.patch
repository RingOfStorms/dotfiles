diff --git a/packages/app/src/hooks/nono-profile-policy.test.ts b/packages/app/src/hooks/nono-profile-policy.test.ts
--- /dev/null
+++ b/packages/app/src/hooks/nono-profile-policy.test.ts
@@ -0,0 +1,20 @@
+import { expect, it } from "vitest";
+import { resolveFeatureValues } from "./feature-preferences";
+import { materializeAgentProfile, toAgentConfigApply } from "../agent-profiles/internal/materialize-profile";
+
+it("does not inherit host access from remembered preferences into a default-on profile", () => {
+  const features = [{ type: "toggle" as const, id: "nonoSandbox", label: "Nono sandbox", value: true }];
+  const resolve = (localFeatureValues: Record<string, unknown>) => resolveFeatureValues({
+    features,
+    persistedFeatureValues: { nonoSandbox: false },
+    localFeatureValues,
+  });
+  expect(resolve({}).nonoSandbox).not.toBe(false);
+  const safe = materializeAgentProfile({ id: "safe", name: "Safe", provider: "omp" });
+  expect(resolve(safe.featureValues).nonoSandbox).toBe(true);
+  expect(toAgentConfigApply(safe).featureValues?.nonoSandbox).toBe(true);
+  const trusted = materializeAgentProfile({
+    id: "trusted", name: "Trusted", provider: "omp", featureValues: { nonoSandbox: false },
+  });
+  expect(resolve(trusted.featureValues).nonoSandbox).toBe(false);
+});
