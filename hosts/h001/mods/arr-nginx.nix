# Host-side pieces of the `arr` floating container (containers/arr): the
# static /media-health/ alias. Every backend is a route in
# containers/arr/service.nix (the guest is net.private, 10.233.16.2).
{ constants, fleet, ... }:
let
  c = constants.services.nixarr;
  mi = constants.services.mediaIntegrity;
  tls = {
    addSSL = true;
    # Wildcard pushed by h005 (hosts/wildcard-cert-receiver.nix).
    sslCertificate = "/var/lib/fleet-cert/${fleet.global.domain}/current/fullchain.pem";
    sslCertificateKey = "/var/lib/fleet-cert/${fleet.global.domain}/current/key.pem";
  };
  proxy = port: {
    proxyWebsockets = true;
    recommendedProxySettings = true;
    proxyPass = "http://127.0.0.1:${toString port}";
  };
in
{
  # sec-agent.nix renders the sabnzbd and nzbgeek secrets with these groups;
  # host nixarr created them, so keep them (same gids as in the arr guest,
  # which reads the secrets through the bind mount).
  users.groups.media.gid = 169;
  users.groups.prowlarr-api.gid = 980;

  services.nginx.virtualHosts = {
    # transmission :9091 is a route now (transmission.joshuabell.xyz).
    # jellyfin, media (seerr) and books (kavita) are routes in
    # containers/arr/service.nix now (generated by `cnt deploy arr`).
    "h001.net.${fleet.global.domain}".locations."${mi.webPath}" = {
      alias = "/srv/containers/${c.containerName}/${baseNameOf mi.dataDir}/";
      extraConfig = ''
        # tailnet only, no login; o002 (public edge) counts as internet
        deny 100.64.0.5;
        deny fd7a:115c:a1e0::5;
        allow 100.64.0.0/10;
        allow fd7a:115c:a1e0::/48;
        deny all;
        index index.html;
        autoindex off;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
      '';
    };
  };
}
