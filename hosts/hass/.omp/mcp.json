{
  "mcpServers": {
    "hass": {
      "type": "http",
      "url": "http://100.64.0.10:8123/api/mcp",
      "headers": {
        "Authorization": "!. ./.env.local && printf 'Bearer %s' \"$HASS_TOKEN\""
      }
